# --- Station identity -------------------------------------------------
# STATION_ID and JIG_ID identify this physical station in the database.
# These are NOT secret — they appear in every PROGRAMMING_EVENT row.
# The RFQ requires station identity to be preserved through sync (§6.2),
# so these must be stable per machine.
STATION_ID=STN-01
JIG_ID=JIG-01

# Number of module positions on this jig: 4 or 8 (Pricol guide §4).
JIG_POSITIONS=8

# --- Local storage ----------------------------------------------------
# SQLite cache/outbox for Stage 1. Stage 2 keeps this as the offline store.
DATABASE_URL=sqlite:///./data/station.db

# Directory for logs and (later) exported reports.
LOG_DIR=./logs

# --- External tools ---------------------------------------------------
# Absolute paths to the vendor tools. Placed in config, not hardcoded,
# because they differ per station PC.
MPCLI_PATH=D:\BLE_Projects\StationApp\MPCliTool_v1.0.4.25_Windows\mpcli_v1.0.4.25_Windows\mpcli.exe
PRICOL_APP_PATH=C:\Pricol\Pricol_AT_CMD.exe

# --- UnisemBLE box (LAN server), docs/box_integration.md -----------------
# BOX_URL: the "Workstation app (SDK base_url)" line on the box installer's
# finish page. BOX_STATION_KEY: shown once when a supervisor creates this
# station on the box console (Stations page); "Rotate key" issues a new one.
BOX_URL=
BOX_STATION_KEY=
# Master ranges (box console -> Pools) the final MACs are drawn from:
# Stock Only modules keep their Stock MAC, Stock + Pricol modules their
# Pricol MAC.
BOX_MASTER_RANGE_STOCK=
BOX_MASTER_RANGE_PRICOL=
# Addresses per block (the box hands out 1000-20000 normally).
BOX_BLOCK_SIZE=5000
# Finished trays not yet reported are re-sent this often.
BOX_REPORT_RETRY_SECONDS=60

# --- Login ------------------------------------------------------------------
# server: phone number + 6-digit PIN verified by the box; people are
#         registered at head office and can log in on any station.
# test:   an in-memory demo box, TESTING ONLY - never on a production station:
#           Operator    9000000001 / 123456
#           Supervisor  9000000003 / 246810
#           Admin       9000000004 / 135790
#           New PIN     9000000002 / 000000 (asks for a new PIN)
AUTH_MODE=server

# --- USB QR scanner (keyboard wedge) ---------------------------------------
# Module QR handling as in the legacy station tools: keep only hex
# characters and the last QR_CODE_LENGTH of them; the scan completes when
# the scanner's burst ends (no Enter needed). QR_CODE_LENGTH=0 accepts any
# length, ended by the scanner's Enter suffix.
QR_CODE_LENGTH=8
QR_HEX_ONLY=true
# Discard a repeat read of the same code within this time (0 = off).
QR_DEBOUNCE_MS=2000
# Also read scanners set to HID POS mode (Device Manager: "POS HID Barcode
# scanner"); they send reads through Windows, not as keystrokes.
QR_SCANNER_HID_POS=true

# --- Runtime ----------------------------------------------------------
LOG_LEVEL=INFO

SERIAL_BINDING_FILE=./data/serial_bindings.json
# Bind slots by reference modules (Station configuration -> Jig slot
# binding -> Bind from reference modules): a module whose MAC is
# <prefix>:NN, placed in slot NN, identifies that slot's COM port, e.g.
# 22:22:22:22:22:01 in slot 1 ... 22:22:22:22:22:08 in slot 8.
SLOT_REFERENCE_MAC_PREFIX=22:22:22:22:22

# --- MPCLI programming ------------------------------------------------
# true = validated flash -> settle -> write-MAC sequence
# (scripts/program_one_real_dut.py); false = single combined command.
MPCLI_TWO_STEP=true
# Chip erase (separate MPCLI command) before every firmware flash, Stock
# and Pricol: full (-E, whole flash) | keep_first_4k (-C, keeps
# 0x800000-0x801000) | none
MPCLI_CHIP_ERASE=full
MPCLI_PROGRAMMING_TIMEOUT_SECONDS=90

# --- Pricol functional test --------------------------------------------
# After each reset the station sends PRICOLAPP / PRICOLDFU on the slot's
# COM port. Confirm the UART speed on a real DUT with
# scripts/test_pricol_functional.py.
PRICOL_UART_BAUDRATE=115200
PRICOL_RESPONSE_TIMEOUT_SECONDS=3.0
# The operator presses RUN APP TEST / RUN DFU TEST first, then resets the
# modules. Each module prints this start-up line after its reset; the
# command is sent once it arrives (waiting at most PRICOL_RESET_WAIT_SECONDS).
PRICOL_RESET_WAIT_SECONDS=30
PRICOL_START_MESSAGE=### Uart demo interrupt read uart data ###
# UART is 115200 8N1, no flow control, DTR and RTS off (required by the
# jig). Blank = driver default (both on) - for diagnosis only.
PRICOL_UART_DTR=false
PRICOL_UART_RTS=false

# Default firmware images offered in batch setup.
STOCK_FIRMWARE_PATH=
PRICOL_FIRMWARE_PATH=

# --- Golden Rig ---------------------------------------------------------
GOLDEN_RIG_CA_CERTIFICATE=./config/certificates/golden_rig_ca.pem

# Approved rig IDs (certificate common names), comma separated.
# Empty = any rig whose certificate is signed by the CA above.
GOLDEN_RIG_INVENTORY=
# Rigs probed by "Discover rigs" on the Golden Rig binding screen.
GOLDEN_RIG_CANDIDATES=
# e.g. GOLDEN_RIG_CANDIDATES=192.168.10.50:8762,golden-rig-2.local:8762

# --- Access control --------------------------------------------------------
# Supervisor login lapses after this many minutes without Supervisor use.
SUPERVISOR_TIMEOUT_MINUTES=15
# Wrong-password attempts before an account locks, and the lock duration.
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=5

# --- MAC blocks --------------------------------------------------------------
# Low water: fetch the reserve block when the current box block has this
# many addresses left (at least one full jig load).
MAC_CACHE_THRESHOLD=64

# Stock + Pricol: every tray, slot N gets a temporary Stock MAC for the Stock
# firmware and RF test, then its Pricol MAC from a box block. The temporary
# addresses are never reported to the box and may repeat between stations.
# Empty = the built-in list 0A:FF:00:00:00:01 (slot 1) .. 0A:FF:00:00:00:08.
# Set a base to use base + N - 1 instead.
TEMP_STOCK_MAC_BASE=

# --- Simulation (development / training ONLY) ---------------------------
# Replaces MPCLI, Golden Rig, functional tests, serial ports and (without
# BOX_URL) the box with simulators. NEVER enable on a production station.
# Use a separate DATABASE_URL for simulation.
SIMULATION_MODE=false
SIMULATION_DELAY_SECONDS=1.0
# Inject per-slot failures, e.g. stock_program:3,rf:6,pricol_readback:2,app:7
# (absent:5 = no module in slot 5, as MPCLI ERR 6 reports it)
SIMULATION_FAILURES=
